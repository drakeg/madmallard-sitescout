SITESCOUT_BIND=127.0.0.1
SITESCOUT_PORT=8087

# Capture is disabled by default. Use a random 32+ character token if enabled.
SITESCOUT_CAPTURE_ENABLED=false
SITESCOUT_CAPTURE_TOKEN=

# Docker-only private job API; never enable on an Internet-facing host.
SITESCOUT_JOBS_ENABLED=false
# JSON mapping of operator names to lowercase SHA-256 digests; leave unset until needed.
SITESCOUT_OPERATOR_TOKEN_HASHES=
